# 包只分发程序、文档和安装脚本；接收地址初始化之前不启动服务。
set(CPACK_PACKAGE_NAME "ip-reporter")
set(CPACK_PACKAGE_VENDOR "IP Reporter contributors")
set(CPACK_PACKAGE_CONTACT "IP Reporter maintainers")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Lightweight IPv4/IPv6 and heartbeat reporter")
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_INSTALL_DIRECTORY "IpReporter")
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_BINARY_DIR}/packages")
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY ON)
set(CPACK_MONOLITHIC_INSTALL ON)
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")

# 工件名写明构建系统与架构，避免把 Linux 包误认为跨发行版通用包。
string(TOLOWER "${CMAKE_SYSTEM_NAME}" _ip_package_os)
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _ip_package_arch)
if(_ip_package_arch STREQUAL "amd64")
    set(_ip_package_arch "x86_64")
endif()
if(WIN32)
    if(CMAKE_GENERATOR_PLATFORM STREQUAL "ARM64")
        set(_ip_package_arch "arm64")
    elseif(CMAKE_SIZEOF_VOID_P EQUAL 4)
        set(_ip_package_arch "x86")
    endif()
endif()
set(_ip_package_distro "${_ip_package_os}")
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT CMAKE_CROSSCOMPILING AND EXISTS "/etc/os-release")
    file(STRINGS "/etc/os-release" _ip_os_release REGEX "^(ID|VERSION_ID)=")
    foreach(_ip_line IN LISTS _ip_os_release)
        if(_ip_line MATCHES "^ID=(.*)$")
            set(_ip_distro_id "${CMAKE_MATCH_1}")
        elseif(_ip_line MATCHES "^VERSION_ID=(.*)$")
            set(_ip_distro_version "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    string(REGEX REPLACE "[^a-zA-Z0-9_.-]" "" _ip_package_distro "${_ip_distro_id}${_ip_distro_version}")
endif()
set(IP_REPORTER_PACKAGE_PLATFORM "${_ip_package_distro}-${_ip_package_arch}" CACHE STRING "Platform/ABI label used in package filenames")
if(NOT IP_REPORTER_PACKAGE_PLATFORM MATCHES "^[a-zA-Z0-9_.-]+$")
    message(FATAL_ERROR "IP_REPORTER_PACKAGE_PLATFORM may contain only letters, digits, dot, underscore or dash")
endif()
set(CPACK_PACKAGE_FILE_NAME "${CPACK_PACKAGE_NAME}-${PROJECT_VERSION}-${IP_REPORTER_PACKAGE_PLATFORM}")
if(EXISTS "${PROJECT_SOURCE_DIR}/LICENSE")
    set(CPACK_RESOURCE_FILE_LICENSE "${PROJECT_SOURCE_DIR}/LICENSE")
endif()

if(WIN32)
    set(CPACK_GENERATOR "ZIP")
    set(CPACK_PACKAGING_INSTALL_PREFIX "/")
elseif(APPLE)
    set(CPACK_GENERATOR "TGZ")
    set(CPACK_PACKAGING_INSTALL_PREFIX "/")
else()
    set(CPACK_GENERATOR "TGZ")
endif()

# -G DEB/RPM 可在安装对应打包工具的 Linux 主机上生成原生包。
set(CPACK_DEBIAN_PACKAGE_SECTION "net")
set(CPACK_DEBIAN_PACKAGE_PRIORITY "optional")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_FILE_NAME "${CPACK_PACKAGE_NAME}_${PROJECT_VERSION}_${IP_REPORTER_PACKAGE_PLATFORM}.deb")
set(CPACK_RPM_PACKAGE_LICENSE "MIT")
set(CPACK_RPM_PACKAGE_GROUP "Applications/Internet")
set(CPACK_RPM_PACKAGE_AUTOREQPROV ON)
set(CPACK_RPM_FILE_NAME "${CPACK_PACKAGE_FILE_NAME}.rpm")
set(CPACK_RPM_PACKAGE_RELOCATABLE OFF)
include(CPack)
