<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.ip-reporter.agent</string>
<key>ProgramArguments</key><array><string>/usr/local/bin/ip-reporter</string><string>--config</string><string>/etc/ip-reporter/config.json</string></array>
<key>UserName</key><string>nobody</string>
<key>GroupName</key><string>nobody</string>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
<key>ThrottleInterval</key><integer>30</integer>
<key>LowPriorityIO</key><true/>
<key>Nice</key><integer>10</integer>
</dict></plist>
